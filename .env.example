# Database
POSTGRES_DB=acs_db
POSTGRES_USER=acs_user
POSTGRES_PASSWORD=change_me_in_production

# Backend
DATABASE_URL=postgresql://acs_user:change_me_in_production@localhost:5432/acs_db
SECRET_KEY=change_me_to_a_long_random_string_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Provider
# Set to "true" to use deterministic mock AI (no API key required)
AI_MOCK_MODE=true
# Set your Gemini API key here if AI_MOCK_MODE=false
GEMINI_API_KEY=your_gemini_api_key_here

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Refund escalation threshold in paise (500000 = ₹5000)
REFUND_ESCALATION_THRESHOLD=500000
